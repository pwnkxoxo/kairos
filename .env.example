# ==============================================================================
# KAIROS - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and set your Google Gemini API key:
#   cp .env.example .env
#
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# NEVER commit your real .env file with secrets to Git.
# ==============================================================================

# Your Google AI API key (leave empty to run KAIROS in safe local demo mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Hosted model to use (defaults to gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional: Tavily Search API Key for live web research
# Obtain from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Timezone for local date/time handling (default: Asia/Kolkata)
KAIROS_TIMEZONE=Asia/Kolkata
